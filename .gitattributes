# Files consumed by Linux tooling must keep LF endings even when checked out
# on Windows: a CRLF inside a Dockerfile RUN line breaks shell continuations.
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.sh            text eol=lf
*.sql           text eol=lf
Caddyfile       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile.*    text eol=lf

# Windows launchers and the standalone installer: cmd.exe wants CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
