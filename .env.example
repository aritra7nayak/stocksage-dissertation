# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stocksage:stocksage_secret_2026@localhost:5433/stocksage
DATABASE_URL_SYNC=postgresql://stocksage:stocksage_secret_2026@localhost:5433/stocksage

# ── Capital allocation (Rules R1–R5) ──────────────────────────────────
TOTAL_CAPITAL=100000
CASH_RESERVE_PCT=0.20
GOLD_SILVER_PCT=0.20
NIFTY50_PCT=0.30
NIFTY_NEXT100_PCT=0.20
SMALLCAP_PCT=0.10

# ── Purchase bands (Rules R6–R7) ──────────────────────────────────────
MIN_STOCK_PURCHASE=7000
MAX_STOCK_PURCHASE=9000
MIN_ETF_PURCHASE=5000
MAX_ETF_PURCHASE=6000

# ── Daily limits (Rule R8) ────────────────────────────────────────────
MAX_DAILY_INVEST_PCT=0.20

# ── Sell rules (R13–R15, added by architecture review) ───────────────
STOP_LOSS_PCT=0.08              # R13: exit if down 8% from avg buy
DETERIORATION_SCORE=0.35        # R14: exit if composite score below this...
DETERIORATION_DAYS=3            # ...for this many consecutive days
TRAILING_PROFIT_TRIGGER=0.15    # R15: once up 15%...
TRAILING_PROFIT_GIVEBACK=0.05   # ...sell if it gives back 5% from peak

# ── Guards (R11–R12) ──────────────────────────────────────────────────
NIFTY_FALL_THRESHOLD=-0.10      # % change considered "fell" (-0.10% = any real red day)
BAD_NEWS_HEADLINE_LIMIT=3       # market-stopper if more than N severe headlines

# ── Sentiment / ML ────────────────────────────────────────────────────
FINBERT_MODEL=ProsusAI/finbert
FINBERT_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43   # pinned Hub commit; empty = latest / local path
NEWS_POLL_MINUTES=30          # news-only collection between engine runs; 0 = off
# Champion/shadow from research.registry (models/serving.json) override FINBERT_MODEL.
SERVING_CONFIG=               # empty = models/serving.json at the repo root
SHADOW_ENABLED=true           # score new headlines with the registry's shadow model too
METRICS_TOKEN=                # bearer token for /metrics; set it if the API is internet-facing
USE_GPU=true
NEWS_API_KEY=                    # optional — RSS feeds work without any key

# ── Deployment (see DEPLOY.md) ────────────────────────────────────────
# Leave these at their defaults for local development. The production stack
# (deploy/docker-compose.prod.yml) sets USE_GPU/ENABLE_SCHEDULER/SERVE_FRONTEND
# and both DATABASE_URLs itself; there you only fill in deploy/.env.
#
# AUTH_SECRET=                   # 64 hex chars; without it, every restart logs
#                                # everyone out. Generate:
#                                #   python -c "import secrets;print(secrets.token_hex(32))"
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#                                # Only matters when the frontend is on a
#                                # different origin than the API.
# SERVE_FRONTEND=false           # true = FastAPI also serves ./static (the SPA)
# ENABLE_SCHEDULER=true          # false on hosts that sleep; use POST /api/engine/run
# ALLOW_REGISTRATION=false       # first user always allowed; set true to invite
#                                # more people, then set it back to false
# DB_POOL_SIZE=5                 # keep small on free managed Postgres
# DB_MAX_OVERFLOW=2

# ── App ───────────────────────────────────────────────────────────────
PAPER_TRADING=true               # virtual execution by default — flip after backtests look good
TIMEZONE=Asia/Kolkata
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=30
MIDDAY_REFRESH_HOUR=12
MIDDAY_REFRESH_MINUTE=30
EOD_SNAPSHOT_HOUR=16
EOD_SNAPSHOT_MINUTE=0

# ── Research only (research/prelabel.py); never used by the app ──
GEMINI_API_KEY=                # aistudio.google.com -> Get API key
GEMINI_MODEL=gemini-3.8-flash  # any Flash model your key's free tier lists

# ── MLOps (research/ scripts; docker compose --profile mlops up -d mlflow) ──
# Training, evaluation, the registry and drift reports log here when set.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
