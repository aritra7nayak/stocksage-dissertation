# Copy to deploy/.env on the VM and fill in. Never commit the real file.

# ── Required for both setups ─────────────────────────────────────────────
# Your domain, pointed at this VM's public IP with an A record.
# A free DuckDNS subdomain works fine: stocksage-india.duckdns.org
DOMAIN=

# Generate:  openssl rand -hex 32
# Without this, every container restart invalidates all login sessions.
AUTH_SECRET=

# ── Setup A: managed Postgres (docker-compose.neon.yml) ──────────────────
# Your Neon connection string, in BOTH forms. They are identical except for
# the driver prefix on the first one.
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_SYNC=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_URL_SYNC=

# ── Setup B: Postgres on this VM (docker-compose.prod.yml) ───────────────
# Leave the two DATABASE_URLs above blank and set this instead.
# Generate:  openssl rand -hex 24
# POSTGRES_PASSWORD=
